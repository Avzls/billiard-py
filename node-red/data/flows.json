  {
    "id": "ui_chart_duration",
    "type": "ui_template",
    "z": "tab_billiard_monitoring",
    "name": "Duration Overview",
    "group": "ui_group_chart",
    "order": 1,
    "width": "24",
    "height": "8",
    "format": "<style>\n  .duration-shell {\n    background:#ffffff;\n    border:1px solid #dfe4dd;\n    border-radius:20px;\n    padding:22px;\n    color:#102033;\n  }\n  .duration-head {\n    display:flex;\n    justify-content:space-between;\n    align-items:flex-start;\n    margin-bottom:20px;\n  }\n  .duration-head-title {\n    font-size:26px;\n    font-weight:600;\n  }\n  .duration-head-copy {\n    margin-top:4px;\n    color:#6b7280;\n    font-size:14px;\n  }\n  .duration-head-icon {\n    color:#6b7280;\n    font-size:18px;\n  }\n  .duration-list-row {\n    display:grid;\n    grid-template-columns:72px 1fr 54px;\n    gap:16px;\n    align-items:center;\n    margin-bottom:16px;\n  }\n  .duration-list-row:last-child { margin-bottom:0; }\n  .duration-list-label {\n    color:#334155;\n    font-size:14px;\n  }\n  .duration-list-track {\n    height:8px;\n    background:#edf1ea;\n    border-radius:999px;\n    overflow:hidden;\n  }\n  .duration-list-fill {\n    height:100%;\n    background:#10a36d;\n    border-radius:999px;\n  }\n  .duration-list-value {\n    text-align:right;\n    font-size:14px;\n    color:#111827;\n  }\n  @media (max-width: 900px) {\n    .duration-list-row { grid-template-columns:1fr; gap:8px; }\n    .duration-list-value { text-align:left; }\n  }\n</style>\n<div class=\"duration-shell\">\n  <div class=\"duration-head\">\n    <div>\n      <div class=\"duration-head-title\">Durasi Pemakaian</div>\n      <div class=\"duration-head-copy\">Per meja, dalam menit</div>\n    </div>\n    <div class=\"duration-head-icon\">o</div>\n  </div>\n  <div class=\"duration-list-row\" ng-repeat=\"idx in [1,2,3,4,5] track by idx\">\n    <div class=\"duration-list-label\">Meja {{idx}}</div>\n    <div class=\"duration-list-track\">\n      <div class=\"duration-list-fill\" ng-style=\"{'width': progress(tables[idx]) + '%'}\"></div>\n    </div>\n    <div class=\"duration-list-value\">{{tables[idx].duration_minutes || 0}}m</div>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.tables = scope.tables || {};\n  scope.progress = function(table) {\n    const minutes = table && table.duration_minutes ? table.duration_minutes : 0;\n    return Math.min((minutes / 120) * 100, 100);\n  };\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.topic) return;\n    const match = /Meja\\s+(\\d+)/.exec(msg.topic);\n    if (!match) return;\n    const tableId = Number(match[1]);\n    scope.tables[tableId] = {\n      duration_minutes: msg.payload\n    };\n  });\n})(scope);\n</script>",
