  {
    "id": "ui_template_tables",
    "type": "ui_template",
    "z": "tab_billiard_monitoring",
    "group": "ui_group_overview",
    "name": "Table Status Cards",
    "order": 1,
    "width": "24",
    "height": "16",
    "format": "<style>\n  body.nr-dashboard-theme,\n  .nr-dashboard-theme,\n  .nr-dashboard-theme md-content,\n  .nr-dashboard-theme ui-card-panel,\n  .nr-dashboard-theme .nr-dashboard-template,\n  .nr-dashboard-theme .nr-dashboard-cardcontainer {\n    background: #f6f7f3 !important;\n  }\n  .nr-dashboard-theme md-toolbar,\n  .nr-dashboard-theme md-toolbar .md-toolbar-tools {\n    background: #10a36d !important;\n    color: #ffffff !important;\n  }\n  .nr-dashboard-theme md-toolbar .md-button,\n  .nr-dashboard-theme md-toolbar .md-toolbar-tools .md-button,\n  .nr-dashboard-theme md-toolbar .md-toolbar-tools h1,\n  .nr-dashboard-theme md-toolbar .md-toolbar-tools h2,\n  .nr-dashboard-theme md-toolbar .md-toolbar-tools h3 {\n    color: #ffffff !important;\n  }\n  .nr-dashboard-theme .nr-dashboard-cardcontainer,\n  .nr-dashboard-theme .nr-dashboard-template,\n  .nr-dashboard-theme ui-card-panel,\n  .nr-dashboard-theme .grid-stack,\n  .nr-dashboard-theme .grid-stack-item,\n  .nr-dashboard-theme .grid-stack-item-content,\n  .nr-dashboard-theme .nr-dashboard-layout-row,\n  .nr-dashboard-theme .nr-dashboard-layout-col {\n    max-width: none !important;\n    overflow: visible !important;\n  }\n  .nr-dashboard-theme .grid-stack,\n  .nr-dashboard-theme .nr-dashboard-cardpanel {\n    width: 100% !important;\n    box-shadow: none !important;\n  }\n  .nr-dashboard-theme .nr-dashboard-cardtitle {\n    padding: 0 0 10px 0 !important;\n  }\n  .nr-dashboard-theme .nr-dashboard-cardtitle span {\n    color: #0b8f6d !important;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    font-size: 12px;\n  }\n  .nr-dashboard-theme .md-padding,\n  .nr-dashboard-theme md-card,\n  .nr-dashboard-theme ui-card-panel {\n    margin: 0 !important;\n    padding: 0 !important;\n  }\n  .billiard-page {\n    width: 100%;\n    margin: 0;\n    background: #f6f7f3;\n    min-height: 100vh;\n    color: #102033;\n    font-family: 'Segoe UI', Tahoma, sans-serif;\n    padding-bottom: 18px;\n  }\n  .billiard-topbar {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    padding:18px 26px;\n    border-bottom:1px solid #0d8b5d;\n    background: #10a36d;\n    color:#ffffff;\n  }\n  .brand-box {\n    display:flex;\n    align-items:center;\n    gap:12px;\n  }\n  .brand-mark {\n    width:28px;\n    height:28px;\n    border-radius:9px;\n    background:#111b26;\n    position:relative;\n  }\n  .brand-mark::after {\n    content:'';\n    position:absolute;\n    inset:8px;\n    border:1.6px solid #fff;\n    border-radius:50%;\n  }\n  .brand-title {\n    font-size:20px;\n    font-weight:600;\n    line-height:1;\n  }\n  .brand-subtitle {\n    margin-top:4px;\n    font-size:11px;\n    color:rgba(255,255,255,0.78);\n    letter-spacing:0.08em;\n    text-transform:uppercase;\n  }\n  .status-meta {\n    display:flex;\n    align-items:center;\n    gap:14px;\n    color:rgba(255,255,255,0.9);\n    font-size:12px;\n  }\n  .live-pill {\n    display:flex;\n    align-items:center;\n    gap:8px;\n    padding:8px 14px;\n    border-radius:999px;\n    border:1px solid rgba(255,255,255,0.24);\n    background:rgba(255,255,255,0.12);\n    color:#ffffff;\n  }\n  .live-dot {\n    width:8px;\n    height:8px;\n    border-radius:50%;\n    background:#5fc28d;\n    box-shadow:0 0 0 4px rgba(95,194,141,0.18);\n  }\n  .billiard-content {\n    padding:28px 26px 18px;\n  }\n  .eyebrow {\n    margin:0 0 10px;\n    color:#059669;\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    font-size:12px;\n    font-weight:700;\n  }\n  .hero-title {\n    margin:0;\n    font-size:52px;\n    line-height:1.02;\n    font-weight:300;\n    color:#0b1729;\n  }\n  .hero-copy {\n    margin:12px 0 28px;\n    color:#4b5563;\n    font-size:18px;\n  }\n  .summary-strip {\n    display:grid;\n    grid-template-columns:repeat(3, 1fr);\n    border:1px solid #dfe4dd;\n    border-radius:22px;\n    background:#fbfcfa;\n    overflow:hidden;\n    margin-bottom:34px;\n  }\n  .summary-card {\n    display:flex;\n    align-items:center;\n    gap:16px;\n    padding:22px;\n    min-height:88px;\n  }\n  .summary-card + .summary-card { border-left:1px solid #dfe4dd; }\n  .summary-icon {\n    width:36px;\n    height:36px;\n    border-radius:50%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-size:16px;\n    background:#eef2f7;\n  }\n  .summary-card.inuse .summary-icon { color:#0f9f6e; }\n  .summary-card.available .summary-icon { color:#64748b; }\n  .summary-card.alarm .summary-icon { color:#ef4444; }\n  .summary-label {\n    font-size:11px;\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    color:#6b7280;\n    margin-bottom:5px;\n  }\n  .summary-value {\n    font-size:38px;\n    line-height:1;\n    font-weight:500;\n    color:#0b1729;\n  }\n  .section-head {\n    display:flex;\n    justify-content:space-between;\n    align-items:center;\n    margin-bottom:16px;\n  }\n  .section-title {\n    font-size:24px;\n    font-weight:600;\n    color:#102033;\n  }\n  .section-meta {\n    color:#6b7280;\n    font-size:13px;\n  }\n  .card-grid {\n    display:grid;\n    grid-template-columns:repeat(5, minmax(0, 1fr));\n    gap:14px;\n    margin-bottom:10px;\n  }\n  .table-card {\n    background:#fff;\n    border:1px solid #dfe4dd;\n    border-radius:18px;\n    padding:16px 18px 18px;\n    box-shadow:0 2px 12px rgba(15,23,42,0.03);\n    min-height:176px;\n  }\n  .table-card.alarm {\n    border-color:#fecaca;\n    background:#fff5f5;\n  }\n  .table-headline {\n    display:flex;\n    justify-content:space-between;\n    align-items:flex-start;\n    gap:8px;\n    margin-bottom:16px;\n  }\n  .table-tag {\n    font-size:11px;\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    color:#6b7280;\n    margin-bottom:6px;\n  }\n  .table-number {\n    font-size:24px;\n    font-weight:600;\n    color:#071224;\n  }\n  .state-pill {\n    display:inline-flex;\n    align-items:center;\n    gap:6px;\n    padding:6px 10px;\n    border-radius:999px;\n    border:1px solid #e5e7eb;\n    background:#fbfbfb;\n    color:#334155;\n    font-size:11px;\n    font-weight:700;\n    letter-spacing:0.05em;\n    text-transform:uppercase;\n    white-space:nowrap;\n  }\n  .state-pill::before {\n    content:'';\n    width:6px;\n    height:6px;\n    border-radius:50%;\n    background:#9ca3af;\n  }\n  .state-pill.used::before { background:#10b981; }\n  .state-pill.free::before { background:#cbd5e1; }\n  .state-pill.alarm::before { background:#ef4444; }\n  .minutes-value {\n    display:flex;\n    align-items:flex-end;\n    gap:8px;\n    margin-bottom:16px;\n  }\n  .minutes-value .number {\n    font-size:50px;\n    line-height:0.95;\n    font-weight:300;\n    color:#071224;\n  }\n  .minutes-value .unit {\n    font-size:14px;\n    color:#6b7280;\n    padding-bottom:7px;\n  }\n  .mini-track {\n    height:4px;\n    background:#edf1ea;\n    border-radius:999px;\n    overflow:hidden;\n    margin-bottom:12px;\n  }\n  .mini-fill {\n    height:100%;\n    background:#10a36d;\n    border-radius:999px;\n  }\n  .table-card.alarm .mini-fill { background:#ef4444; }\n  .table-foot {\n    display:flex;\n    justify-content:space-between;\n    color:#6b7280;\n    font-size:13px;\n  }\n  @media (max-width: 1400px) {\n    .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  }\n  @media (max-width: 900px) {\n    .hero-title { font-size:38px; }\n    .summary-strip { grid-template-columns:1fr; }\n    .summary-card + .summary-card { border-left:0; border-top:1px solid #dfe4dd; }\n    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .status-meta { display:none; }\n  }\n  @media (max-width: 600px) {\n    .card-grid { grid-template-columns: 1fr; }\n  }\n</style>\n<div class=\"billiard-page\">\n  <div class=\"billiard-topbar\">\n    <div class=\"brand-box\">\n      <div class=\"brand-mark\"></div>\n      <div>\n        <div class=\"brand-title\">Billiard</div>\n        <div class=\"brand-subtitle\">Floor Monitor</div>\n      </div>\n    </div>\n    <div class=\"status-meta\">\n      <div class=\"live-pill\"><span class=\"live-dot\"></span> Live</div>\n      <div>{{timeNow}}</div>\n    </div>\n  </div>\n  <div class=\"billiard-content\">\n    <div class=\"eyebrow\">Status Meja</div>\n    <h2 class=\"hero-title\">Live Floor Monitor</h2>\n    <div class=\"hero-copy\">Ringkasan operasional meja billiard secara realtime.</div>\n    <div class=\"summary-strip\">\n      <div class=\"summary-card inuse\">\n        <div class=\"summary-icon\">~</div>\n        <div>\n          <div class=\"summary-label\">In Use</div>\n          <div class=\"summary-value\">{{summary.inUse}}</div>\n        </div>\n      </div>\n      <div class=\"summary-card available\">\n        <div class=\"summary-icon\">x</div>\n        <div>\n          <div class=\"summary-label\">Available</div>\n          <div class=\"summary-value\">{{summary.free}}</div>\n        </div>\n      </div>\n      <div class=\"summary-card alarm\">\n        <div class=\"summary-icon\">!</div>\n        <div>\n          <div class=\"summary-label\">Alarm</div>\n          <div class=\"summary-value\">{{summary.alarm}}</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"section-head\">\n      <div class=\"section-title\">Tables</div>\n      <div class=\"section-meta\">{{summary.total}} total</div>\n    </div>\n    <div class=\"card-grid\">\n      <div class=\"table-card {{tables[idx].alarm ? 'alarm' : ''}}\" ng-repeat=\"idx in [1,2,3,4,5] track by idx\">\n        <div class=\"table-headline\">\n          <div>\n            <div class=\"table-tag\">Table</div>\n            <div class=\"table-number\">{{pad(idx)}}</div>\n          </div>\n          <div class=\"state-pill {{tables[idx].alarm ? 'alarm' : (tables[idx].status === 'dipakai' ? 'used' : 'free')}}\">{{tables[idx].alarm ? 'Alarm' : (tables[idx].status === 'dipakai' ? 'In Use' : 'Available')}}</div>\n        </div>\n        <div class=\"minutes-value\">\n          <div class=\"number\">{{tables[idx].duration_minutes || 0}}</div>\n          <div class=\"unit\">min</div>\n        </div>\n        <div class=\"mini-track\">\n          <div class=\"mini-fill\" ng-style=\"{'width': progress(tables[idx]) + '%'}\"></div>\n        </div>\n        <div class=\"table-foot\">\n          <span>Overtime</span>\n          <span>{{tables[idx].overtime_minutes || 0}}m</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.tables = scope.tables || {};\n  scope.summary = scope.summary || { inUse: 0, free: 0, alarm: 0, total: 5 };\n  scope.pad = function(value) { return String(value).padStart(2, '0'); };\n  scope.progress = function(table) {\n    const minutes = table && table.duration_minutes ? table.duration_minutes : 0;\n    return Math.min((minutes / 120) * 100, 100);\n  };\n  scope.updateClock = function() {\n    scope.timeNow = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });\n  };\n  scope.recalculateSummary = function() {\n    const values = Object.values(scope.tables);\n    scope.summary = {\n      inUse: values.filter((table) => table.status === 'dipakai').length,\n      free: values.filter((table) => table.status === 'kosong').length,\n      alarm: values.filter((table) => table.alarm).length,\n      total: 5\n    };\n  };\n  scope.updateClock();\n  setInterval(function() {\n    scope.$applyAsync(function() { scope.updateClock(); });\n  }, 1000);\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    scope.tables[msg.payload.table_id] = msg.payload;\n    scope.recalculateSummary();\n  });\n})(scope);\n</script>",
