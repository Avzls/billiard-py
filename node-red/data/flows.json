  {
    "id": "ui_text_alarm",
    "type": "ui_template",
    "z": "tab_billiard_monitoring",
    "group": "ui_group_alarm",
    "order": 1,
    "width": "24",
    "height": "5",
    "name": "Alarm Panel",
    "format": "<style>\n  .alarm-minimal {\n    background:#ffffff;\n    border:1px solid #dfe4dd;\n    border-radius:20px;\n    padding:18px 20px;\n    color:#102033;\n  }\n  .alarm-minimal-title {\n    font-size:20px;\n    font-weight:600;\n    margin-bottom:12px;\n  }\n  .alarm-empty {\n    color:#6b7280;\n    font-size:14px;\n  }\n  .alarm-grid {\n    display:grid;\n    grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));\n    gap:12px;\n  }\n  .alarm-tile {\n    border-radius:16px;\n    border:1px solid #fecaca;\n    background:#fff4f4;\n    padding:14px 16px;\n  }\n  .alarm-tile-title {\n    font-size:15px;\n    font-weight:700;\n    margin-bottom:6px;\n  }\n  .alarm-tile-copy {\n    font-size:13px;\n    color:#475569;\n    line-height:1.5;\n  }\n</style>\n<div class=\"alarm-minimal\">\n  <div class=\"alarm-minimal-title\">Alarm Overtime</div>\n  <div ng-if=\"activeAlarms.length === 0\" class=\"alarm-empty\">Semua meja masih dalam batas durasi normal.</div>\n  <div ng-if=\"activeAlarms.length > 0\" class=\"alarm-grid\">\n    <div class=\"alarm-tile\" ng-repeat=\"table in activeAlarms track by table.table_id\">\n      <div class=\"alarm-tile-title\">{{table.table_name}}</div>\n      <div class=\"alarm-tile-copy\">Overtime {{table.overtime_minutes}} menit dari total {{table.duration_minutes}} menit.</div>\n    </div>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.tables = scope.tables || {};\n  scope.activeAlarms = scope.activeAlarms || [];\n  scope.refreshAlarms = function() {\n    scope.activeAlarms = Object.values(scope.tables)\n      .filter((table) => table.alarm)\n      .sort((a, b) => b.overtime_minutes - a.overtime_minutes);\n  };\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    scope.tables[msg.payload.table_id] = msg.payload;\n    scope.refreshAlarms();\n  });\n})(scope);\n</script>",
