  {
    "id": "function_prepare_messages",
    "type": "function",
    "z": "tab_billiard_monitoring",
    "name": "Prepare Dashboard and Influx",
    "func": "const table = msg.payload;\nconst overviewMsg = {\n    payload: table,\n    topic: `table/${table.table_id}`\n};\nconst chartMsg = {\n    topic: table.table_name,\n    payload: table.duration_minutes\n};\nconst alarmMsg = {\n    payload: table\n};\nreturn [overviewMsg, chartMsg, alarmMsg];",
    "outputs": 3,
    "noerr": 0,
