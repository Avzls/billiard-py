  {
    "id": "ui_text_alarm",
    "type": "ui_template",
    "z": "tab_billiard_monitoring",
    "group": "ui_group_alarm",
    "order": 1,
    "width": "24",
    "height": "6",
    "name": "Alarm Panel",
    "format": "<style>\n  .alarm-board {\n    display:grid;\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n    gap:12px;\n  }\n  .alarm-card {\n    border-radius:16px;\n    padding:14px 16px;\n    background:#f8fafc;\n    border:1px solid rgba(15,23,42,0.08);\n    box-shadow:0 10px 24px rgba(15,23,42,0.06);\n  }\n  .alarm-card.alert {\n    background:linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%);\n    border-color:#fecaca;\n  }\n  .alarm-title {\n    font-size:15px;\n    font-weight:800;\n    margin-bottom:6px;\n    color:#0f172a;\n  }\n  .alarm-body {\n    font-size:13px;\n    color:#334155;\n    line-height:1.5;\n  }\n  .alarm-empty {\n    border-radius:16px;\n    padding:18px;\n    background:linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%);\n    color:#0f172a;\n    border:1px solid #bfdbfe;\n    font-weight:700;\n  }\n</style>\n<div ng-if=\"activeAlarms.length === 0\" class=\"alarm-empty\">Semua meja dalam kondisi normal. Belum ada overtime aktif.</div>\n<div ng-if=\"activeAlarms.length > 0\" class=\"alarm-board\">\n  <div class=\"alarm-card alert\" ng-repeat=\"table in activeAlarms track by table.table_id\">\n    <div class=\"alarm-title\">{{table.table_name}}</div>\n    <div class=\"alarm-body\">\n      Overtime {{table.overtime_minutes}} menit.<br>\n      Durasi total {{table.duration_minutes}} menit.<br>\n      Update {{formatTime(table.updated_at)}}\n    </div>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.tables = scope.tables || {};\n  scope.activeAlarms = scope.activeAlarms || [];\n  scope.formatTime = function(value) {\n    if (!value) return '-';\n    const date = new Date(value);\n    if (Number.isNaN(date.getTime())) return value;\n    return date.toLocaleString('id-ID', {\n      hour12: false,\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit'\n    });\n  };\n  scope.refreshAlarms = function() {\n    scope.activeAlarms = Object.values(scope.tables)\n      .filter((table) => table.alarm)\n      .sort((a, b) => b.overtime_minutes - a.overtime_minutes);\n  };\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    scope.tables[msg.payload.table_id] = msg.payload;\n    scope.refreshAlarms();\n  });\n})(scope);\n</script>",
    "storeOutMessages": true,
