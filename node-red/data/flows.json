  {
    "id": "ui_template_tables",
    "type": "ui_template",
    "z": "tab_billiard_monitoring",
    "group": "ui_group_overview",
    "name": "Table Status Cards",
    "order": 1,
    "width": "24",
    "height": "10",
    "format": "<style>\n  .billiard-shell {\n    background: linear-gradient(135deg, #fffdf6 0%, #f6fbff 55%, #eef7f2 100%);\n    border-radius: 22px;\n    padding: 18px;\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.85), 0 14px 32px rgba(15, 23, 42, 0.08);\n  }\n  .billiard-hero {\n    display:flex;\n    justify-content:space-between;\n    align-items:flex-start;\n    gap:16px;\n    margin-bottom:18px;\n    padding:18px;\n    border-radius:18px;\n    background: linear-gradient(135deg, #0f766e 0%, #0891b2 100%);\n    color:#f8fafc;\n  }\n  .billiard-hero h2 {\n    margin:0 0 6px;\n    font-size:28px;\n    line-height:1.1;\n    font-weight:800;\n  }\n  .billiard-hero p {\n    margin:0;\n    opacity:0.9;\n    font-size:13px;\n  }\n  .summary-grid {\n    display:grid;\n    grid-template-columns: repeat(3, minmax(110px, 1fr));\n    gap:10px;\n    min-width: 330px;\n  }\n  .summary-pill {\n    background: rgba(255,255,255,0.16);\n    border: 1px solid rgba(255,255,255,0.2);\n    border-radius: 16px;\n    padding: 10px 12px;\n    backdrop-filter: blur(8px);\n  }\n  .summary-pill .label {\n    font-size: 11px;\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    opacity: 0.78;\n  }\n  .summary-pill .value {\n    font-size: 24px;\n    font-weight: 800;\n    margin-top: 4px;\n  }\n  .table-grid {\n    display:grid;\n    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));\n    gap:14px;\n  }\n  .table-card {\n    position:relative;\n    overflow:hidden;\n    border-radius:18px;\n    padding:16px;\n    border:1px solid rgba(15, 23, 42, 0.08);\n    box-shadow:0 10px 25px rgba(15, 23, 42, 0.08);\n    background:#ffffff;\n  }\n  .table-card::before {\n    content:'';\n    position:absolute;\n    inset:0 auto 0 0;\n    width:8px;\n    background:#94a3b8;\n  }\n  .table-card.free { background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%); }\n  .table-card.free::before { background:#16a34a; }\n  .table-card.used { background: linear-gradient(180deg, #fffbeb 0%, #fef3c7 100%); }\n  .table-card.used::before { background:#d97706; }\n  .table-card.alarm { background: linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%); }\n  .table-card.alarm::before { background:#dc2626; }\n  .table-card.alarm::after {\n    content:'';\n    position:absolute;\n    inset:0;\n    background:linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.55) 45%, rgba(255,255,255,0) 100%);\n    transform:translateX(-100%);\n    animation: shimmer 1.4s infinite;\n  }\n  .table-top {\n    display:flex;\n    justify-content:space-between;\n    gap:10px;\n    align-items:flex-start;\n    margin-bottom:14px;\n  }\n  .table-name {\n    font-size:20px;\n    font-weight:800;\n    color:#0f172a;\n  }\n  .status-badge {\n    border-radius:999px;\n    padding:6px 10px;\n    font-size:11px;\n    font-weight:700;\n    letter-spacing:0.06em;\n    text-transform:uppercase;\n    color:#0f172a;\n    background:rgba(255,255,255,0.72);\n  }\n  .table-main {\n    display:flex;\n    justify-content:space-between;\n    align-items:flex-end;\n    margin-bottom:14px;\n  }\n  .duration-block .caption {\n    font-size:11px;\n    text-transform:uppercase;\n    letter-spacing:0.08em;\n    color:#475569;\n  }\n  .duration-block .value {\n    font-size:34px;\n    font-weight:800;\n    color:#0f172a;\n    line-height:1;\n  }\n  .duration-block .unit {\n    font-size:12px;\n    color:#334155;\n    margin-top:4px;\n  }\n  .mini-kpi {\n    text-align:right;\n    font-size:12px;\n    color:#334155;\n  }\n  .mini-kpi strong {\n    display:block;\n    font-size:15px;\n    color:#0f172a;\n  }\n  .progress-track {\n    height:10px;\n    border-radius:999px;\n    background:rgba(255,255,255,0.75);\n    overflow:hidden;\n    margin-bottom:10px;\n  }\n  .progress-fill {\n    height:100%;\n    border-radius:999px;\n    background:linear-gradient(90deg, #22c55e 0%, #84cc16 100%);\n  }\n  .table-card.used .progress-fill { background:linear-gradient(90deg, #f59e0b 0%, #f97316 100%); }\n  .table-card.alarm .progress-fill { background:linear-gradient(90deg, #ef4444 0%, #dc2626 100%); }\n  .update-row {\n    display:flex;\n    justify-content:space-between;\n    gap:12px;\n    font-size:12px;\n    color:#475569;\n  }\n  .update-row strong {\n    color:#0f172a;\n  }\n  @keyframes shimmer {\n    100% { transform:translateX(100%); }\n  }\n  @media (max-width: 900px) {\n    .billiard-hero { flex-direction:column; }\n    .summary-grid { min-width:0; width:100%; }\n  }\n</style>\n<div class=\"billiard-shell\">\n  <div class=\"billiard-hero\">\n    <div>\n      <h2>Live Floor Monitor</h2>\n      <p>Ringkasan operasional meja billiard secara realtime.</p>\n    </div>\n    <div class=\"summary-grid\">\n      <div class=\"summary-pill\">\n        <div class=\"label\">Dipakai</div>\n        <div class=\"value\">{{summary.inUse}}</div>\n      </div>\n      <div class=\"summary-pill\">\n        <div class=\"label\">Kosong</div>\n        <div class=\"value\">{{summary.free}}</div>\n      </div>\n      <div class=\"summary-pill\">\n        <div class=\"label\">Alarm</div>\n        <div class=\"value\">{{summary.alarm}}</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"table-grid\">\n    <div class=\"table-card {{tables[idx].alarm ? 'alarm' : (tables[idx].status === 'dipakai' ? 'used' : 'free')}}\" ng-repeat=\"idx in [1,2,3,4,5] track by idx\">\n      <div class=\"table-top\">\n        <div class=\"table-name\">{{tables[idx].table_name || ('Meja ' + idx)}}</div>\n        <div class=\"status-badge\">{{tables[idx].status || 'menunggu'}}</div>\n      </div>\n      <div class=\"table-main\">\n        <div class=\"duration-block\">\n          <div class=\"caption\">Durasi</div>\n          <div class=\"value\">{{tables[idx].duration_minutes || 0}}</div>\n          <div class=\"unit\">menit</div>\n        </div>\n        <div class=\"mini-kpi\">\n          <span>Overtime</span>\n          <strong>{{tables[idx].overtime_minutes || 0}} m</strong>\n        </div>\n      </div>\n      <div class=\"progress-track\">\n        <div class=\"progress-fill\" ng-style=\"{'width': ((tables[idx].duration_minutes || 0) > 120 ? 100 : ((tables[idx].duration_minutes || 0) / 120 * 100)) + '%'}\"></div>\n      </div>\n      <div class=\"update-row\">\n        <span><strong>Alarm:</strong> {{tables[idx].alarm ? 'Aktif' : 'Normal'}}</span>\n        <span>{{formatTime(tables[idx].updated_at)}}</span>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.tables = scope.tables || {};\n  scope.summary = scope.summary || { inUse: 0, free: 0, alarm: 0 };\n  scope.formatTime = function(value) {\n    if (!value) return '-';\n    const date = new Date(value);\n    if (Number.isNaN(date.getTime())) return value;\n    return date.toLocaleString('id-ID', {\n      hour12: false,\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit'\n    });\n  };\n  scope.recalculateSummary = function() {\n    const values = Object.values(scope.tables);\n    scope.summary = {\n      inUse: values.filter((table) => table.status === 'dipakai').length,\n      free: values.filter((table) => table.status === 'kosong').length,\n      alarm: values.filter((table) => table.alarm).length\n    };\n  };\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    scope.tables[msg.payload.table_id] = msg.payload;\n    scope.recalculateSummary();\n  });\n})(scope);\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 940,
    "y": 60,
    "wires": [
      []
    ]
  },
